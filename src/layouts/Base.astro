---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import { organization, website } from '../data/seo';

interface Props {
  title: string;
  description: string;
  /** Share image path under /public, 1200x630. */
  image?: string;
  /** Extra schema.org object(s) for this page. */
  jsonLd?: object | object[];
  noindex?: boolean;
}
const { title, description, image = '/og/og-home.png', jsonLd, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://sobiinteractive.com');
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const graph = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, ...extra.map(({ '@context': _c, ...rest }: any) => rest)],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta property="og:site_name" content="SOBI Interactive" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SOBI Interactive, mobile game studio in Vietnam" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#1c1c1c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <div class="cursor" aria-hidden="true"></div>
    <style>
      .skip { position: absolute; left: -9999px; top: 8px; z-index: 200; background: #fff; color: #000; padding: 10px 16px; font-weight: 700; }
      .skip:focus { left: 8px; }
    </style>
    <script>
      // Fade-up on scroll
      const items = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -10% 0px' });
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-in'));
      }

      // Custom cursor
      const cursor = document.querySelector<HTMLElement>('.cursor');
      if (cursor && matchMedia('(pointer: fine)').matches) {
        document.body.classList.add('has-cursor');
        addEventListener('mousemove', (e) => {
          cursor.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
          cursor.classList.add('is-on');
          const t = e.target as Element | null;
          cursor.classList.toggle('is-hover', !!t?.closest('a, button, [data-hover]'));
        });
        document.addEventListener('mouseleave', () => cursor.classList.remove('is-on'));
      }
    </script>
  </body>
</html>
