---
import Base from './Base.astro';

interface Props { title: string; description: string; updated: string; }
const { title, description, updated } = Astro.props;
---
<Base title={`${title} | SOBI Interactive`} description={description}>
  <article class="legal">
    <div class="wrap legal__in">
      <p class="label">Legal</p>
      <h1>{title}</h1>
      <p class="mute legal__date">Last updated: {updated}</p>
      <div class="prose"><slot /></div>
    </div>
  </article>
</Base>

<style>
  .legal { padding: 180px 0 120px; }
  .legal__in { max-width: 860px; }
  .legal h1 { margin-top: 16px; font-size: clamp(40px, 7vw, 72px); }
  .legal__date { margin: 20px 0 0; font-size: 15px; }
  .prose { margin-top: 56px; color: #d6d6d6; }
  .prose :global(h2) { margin: 56px 0 16px; font-size: clamp(22px, 2.6vw, 28px); line-height: 1.15; color: var(--fg); }
  .prose :global(h3) { margin: 32px 0 8px; font-size: 18px; text-transform: none; letter-spacing: 0; line-height: 1.3; color: var(--fg); }
  .prose :global(p), .prose :global(li) { font-weight: 300; }
  .prose :global(p) { margin: 0 0 16px; }
  .prose :global(ul) { margin: 0 0 16px; padding-left: 22px; }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(a) { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(strong) { font-weight: 700; color: var(--fg); }
  @media (max-width: 640px) { .legal { padding-top: 140px; } }
</style>
