---
// Page title block: line 1 solid, line 2 outlined (Imba style).
interface Props { l1: string; l2: string; }
const { l1, l2 } = Astro.props;
---
<section class="phero">
  <div class="wrap">
    <h1 data-reveal>
      <span>{l1}</span>
      <span class="outline">{l2}</span>
    </h1>
    <div class="phero__body" data-reveal><slot /></div>
  </div>
</section>

<style>
  .phero { padding: 200px 0 clamp(80px, 10vw, 140px); }
  .phero h1 { display: flex; flex-direction: column; gap: 0.08em; }
  .phero .outline { -webkit-text-stroke-width: clamp(1px, 0.2vw, 2px); }
  .phero__body { margin-top: 40px; }
  .phero__body :global(p) { margin: 0; }
  .phero__body :global(.actions) { margin-top: 40px; display: flex; flex-wrap: wrap; align-items: center; gap: 20px 32px; }
  @media (max-width: 640px) { .phero { padding-top: 150px; } }
</style>
