---
// Animated tile grid behind the hero: a slow diagonal light wave, tiles that pop like pieces
// being placed, and tiles that light up around the cursor. Monochrome, canvas 2D, pauses off-screen.
---
<canvas class="hero-motion" aria-hidden="true"></canvas>

<style>
  .hero-motion {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(100deg, rgba(0, 0, 0, 0.25) 10%, #000 65%);
    mask-image: linear-gradient(100deg, rgba(0, 0, 0, 0.25) 10%, #000 65%);
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.hero-motion');
  const host = canvas?.parentElement;
  const ctx = canvas?.getContext('2d');
  if (canvas && host && ctx) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let w = 0, h = 0, cell = 56, cols = 0, rows = 0, dpr = 1;
    let pops: { c: number; r: number; born: number }[] = [];
    let mouse = { x: -9999, y: -9999 };
    let running = false;
    let last = 0;

    const resize = () => {
      dpr = Math.min(devicePixelRatio || 1, 2);
      w = host.clientWidth;
      h = host.clientHeight;
      cell = w < 640 ? 40 : 56;
      cols = Math.ceil(w / cell) + 1;
      rows = Math.ceil(h / cell) + 1;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (!running) draw(performance.now());
    };

    const draw = (now: number) => {
      const t = now / 1000;
      ctx.clearRect(0, 0, w, h);
      const size = cell * 0.62;
      const off = (cell - size) / 2;
      // New pieces "drop in" now and then.
      if (!reduce && now - last > 260) {
        last = now;
        pops.push({ c: (Math.random() * cols) | 0, r: (Math.random() * rows) | 0, born: now });
        pops = pops.filter((p) => now - p.born < 2600);
      }
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const x = c * cell + off;
          const y = r * cell + off;
          const wave = reduce ? 0 : Math.pow(Math.max(0, Math.sin(t * 0.7 - (c + r) * 0.22)), 6);
          const dx = x + size / 2 - mouse.x;
          const dy = y + size / 2 - mouse.y;
          const near = Math.exp(-(dx * dx + dy * dy) / (2 * 110 * 110));
          const a = 0.05 + wave * 0.16 + near * 0.45;
          ctx.strokeStyle = `rgba(255,255,255,${a})`;
          ctx.lineWidth = 1;
          ctx.strokeRect(x + 0.5, y + 0.5, size, size);
          if (near > 0.35) {
            ctx.fillStyle = `rgba(255,255,255,${(near - 0.35) * 0.18})`;
            ctx.fillRect(x, y, size, size);
          }
        }
      }
      for (const p of pops) {
        const k = (now - p.born) / 2600; // 0..1
        const ease = k < 0.15 ? k / 0.15 : 1 - (k - 0.15) / 0.85;
        const s = size * (k < 0.15 ? 0.6 + 0.4 * (k / 0.15) : 1);
        const x = p.c * cell + (cell - s) / 2;
        const y = p.r * cell + (cell - s) / 2;
        ctx.fillStyle = `rgba(255,255,255,${0.22 * ease})`;
        ctx.fillRect(x, y, s, s);
      }
    };

    const loop = (now: number) => {
      if (!running) return;
      draw(now);
      requestAnimationFrame(loop);
    };
    const start = () => { if (!running && !reduce) { running = true; requestAnimationFrame(loop); } };
    const stop = () => { running = false; };

    new ResizeObserver(resize).observe(host);
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(host);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    host.addEventListener('pointermove', (e) => {
      const b = host.getBoundingClientRect();
      mouse = { x: e.clientX - b.left, y: e.clientY - b.top };
    });
    host.addEventListener('pointerleave', () => { mouse = { x: -9999, y: -9999 }; });
    resize();
  }
</script>
