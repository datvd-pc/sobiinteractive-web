---
// Static tile grid behind the hero. Nothing moves on its own: only the tiles near the mouse
// glow softly (owner choice 2026-11-19, "Static grid + cursor glow"). Redraws only on mouse move.
---
<canvas class="hero-motion" aria-hidden="true"></canvas>

<style>
  .hero-motion {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(100deg, rgba(0, 0, 0, 0.3) 10%, #000 65%);
    mask-image: linear-gradient(100deg, rgba(0, 0, 0, 0.3) 10%, #000 65%);
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.hero-motion');
  const host = canvas?.parentElement;
  const ctx = canvas?.getContext('2d');
  if (canvas && host && ctx) {
    let w = 0, h = 0, cell = 56, cols = 0, rows = 0;
    let mouse = { x: -9999, y: -9999 };
    let queued = false;

    const draw = () => {
      queued = false;
      ctx.clearRect(0, 0, w, h);
      const size = cell * 0.62;
      const off = (cell - size) / 2;
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const x = c * cell + off;
          const y = r * cell + off;
          const dx = x + size / 2 - mouse.x;
          const dy = y + size / 2 - mouse.y;
          const near = Math.exp(-(dx * dx + dy * dy) / (2 * 90 * 90));
          ctx.strokeStyle = `rgba(255,255,255,${0.05 + near * 0.3})`;
          ctx.lineWidth = 1;
          ctx.strokeRect(x + 0.5, y + 0.5, size, size);
          if (near > 0.5) {
            ctx.fillStyle = `rgba(255,255,255,${(near - 0.5) * 0.08})`;
            ctx.fillRect(x, y, size, size);
          }
        }
      }
    };
    const request = () => { if (!queued) { queued = true; requestAnimationFrame(draw); } };

    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = host.clientWidth;
      h = host.clientHeight;
      cell = w < 640 ? 40 : 56;
      cols = Math.ceil(w / cell) + 1;
      rows = Math.ceil(h / cell) + 1;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw();
    };

    new ResizeObserver(resize).observe(host);
    if (matchMedia('(pointer: fine)').matches) {
      host.addEventListener('pointermove', (e) => {
        const b = host.getBoundingClientRect();
        mouse = { x: e.clientX - b.left, y: e.clientY - b.top };
        request();
      });
      host.addEventListener('pointerleave', () => { mouse = { x: -9999, y: -9999 }; request(); });
    }
    resize();
  }
</script>
