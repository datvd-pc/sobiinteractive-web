---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  icon: ImageMetadata;
  genre: string;
  status: 'IN DEVELOPMENT' | 'COMING SOON' | 'LIVE';
  googlePlay?: string;
  appStore?: string;
}
const { name, icon, genre, status, googlePlay, appStore } = Astro.props;
const showBadges = status !== 'IN DEVELOPMENT';
const live = status === 'LIVE';
const stores = [
  { url: googlePlay, img: '/badges/google-play.png', alt: 'Get it on Google Play', cls: 'gp' },
  { url: appStore, img: '/badges/app-store.svg', alt: 'Download on the App Store', cls: 'as' },
].filter((s) => s.url || !live);
---
<article class="game" data-reveal>
  <Image src={icon} alt={`${name} game icon`} width={360} height={360} class="game__icon" loading="lazy" />
  <h3 class="game__name">{name}</h3>
  <p class="game__meta">
    <span class="game__genre">{genre}</span>
    <span class="game__dot" aria-hidden="true">·</span>
    <span class="game__status">{status}</span>
  </p>
  {showBadges && (
    <div class="game__stores">
      {stores.map((s) =>
        live ? (
          <a href={s.url} target="_blank" rel="noopener" class={`badge badge--${s.cls}`}>
            <img src={s.img} alt={s.alt} />
          </a>
        ) : (
          <span class={`badge badge--${s.cls} is-off`} aria-disabled="true">
            <img src={s.img} alt={`${s.alt} (coming soon)`} />
          </span>
        )
      )}
    </div>
  )}
</article>

<style>
  .game {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 32px 24px 36px;
    background: var(--card);
    border: 1px solid var(--line);
    transition: border-color 0.3s;
  }
  .game:hover { border-color: #555; }
  .game__icon {
    width: 100%;
    max-width: 180px;
    aspect-ratio: 1;
    border-radius: 22%;
    transition: transform 0.4s ease;
  }
  .game:hover .game__icon { transform: translateY(-6px) scale(1.03); }
  .game__name { margin-top: 28px; font-size: clamp(20px, 2.2vw, 26px); }
  .game__meta {
    margin: 14px 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
  }
  .game__genre { color: var(--mute); }
  .game__dot { color: var(--mute); }
  .game__status {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    padding: 4px 8px;
    border: 1px solid #555;
    line-height: 1.2;
  }
  .game__stores { margin-top: 24px; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; align-items: center; }
  .badge img { height: 40px; width: auto; }
  .badge--gp img { height: 58px; margin: -9px -8px; }
  .badge.is-off { opacity: 0.35; cursor: not-allowed; }
  @media (max-width: 560px) {
    .game { padding: 22px 12px 26px; }
    .game__name { margin-top: 18px; }
    .game__meta { flex-direction: column; gap: 6px; }
    .game__dot { display: none; }
    .game__status { font-size: 10px; letter-spacing: 0.06em; padding: 4px 6px; white-space: nowrap; }
  }
</style>
