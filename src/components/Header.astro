---
const nav = [
  { href: '/partners', label: 'Partners' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href="/" class="logo" aria-label="SOBI Interactive, home">
      <span class="logo__main">SOBI</span>
      <span class="logo__sub">Interactive</span>
    </a>
    <nav class="hdr__nav" id="site-nav" aria-label="Main">
      {nav.map((n) => (
        <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
      ))}
      <a href="/partners#submit" class="btn hdr__cta">Work with SOBI</a>
    </nav>
    <button class="hdr__toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    background: rgba(28, 28, 28, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; height: 76px; }
  .logo { display: flex; align-items: baseline; gap: 8px; line-height: 1; }
  .logo__main { font-weight: 900; font-size: 26px; letter-spacing: -0.03em; }
  .logo__sub { font-weight: 300; font-size: 13px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--mute); }
  .hdr__nav { display: flex; align-items: center; gap: 36px; }
  .hdr__nav > a:not(.btn) {
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute);
    transition: color 0.2s;
  }
  .hdr__nav > a:not(.btn):hover, .hdr__nav > a[aria-current='page'] { color: var(--fg); }
  .hdr__cta { min-height: 44px; padding: 0 20px; font-size: 13px; }
  .hdr__toggle { display: none; }

  @media (max-width: 820px) {
    .hdr__toggle {
      display: grid;
      gap: 7px;
      width: 44px; height: 44px;
      place-content: center;
      background: none;
      border: 1px solid var(--line);
      padding: 0;
    }
    .hdr__toggle span { display: block; width: 20px; height: 2px; background: var(--fg); transition: transform 0.25s; }
    .hdr__toggle[aria-expanded='true'] span:first-child { transform: translateY(4.5px) rotate(45deg); }
    .hdr__toggle[aria-expanded='true'] span:last-child { transform: translateY(-4.5px) rotate(-45deg); }
    .hdr__nav {
      position: fixed;
      top: 76px; left: 0; right: 0;
      height: calc(100dvh - 76px);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 24px var(--gutter);
      background: var(--bg);
      visibility: hidden;
      opacity: 0;
    }
    /* Animate only after the menu button was used, so resizing never flashes the menu. */
    .hdr__nav.is-anim { transition: opacity 0.25s, visibility 0.25s; }
    .hdr__nav.is-open { visibility: visible; opacity: 1; }
    .hdr__nav > a:not(.btn) {
      font-size: 32px;
      font-weight: 900;
      letter-spacing: -0.01em;
      color: var(--fg);
      padding: 18px 0;
      border-bottom: 1px solid var(--line);
    }
    .hdr__cta { margin-top: 32px; min-height: 56px; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.hdr__toggle');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    nav?.classList.add('is-anim');
    nav?.classList.toggle('is-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  });
  nav?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      btn?.setAttribute('aria-expanded', 'false');
      nav.classList.remove('is-open');
      document.body.style.overflow = '';
    })
  );
</script>
