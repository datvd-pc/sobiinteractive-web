---
const cols = [
  { title: 'Company', links: [
    { href: '/about', label: 'About' },
    { href: '/about#careers', label: 'Careers' },
    { href: '/contact', label: 'Contact' },
  ] },
  { title: 'Partners', links: [
    { href: '/partners', label: 'Work with SOBI' },
    { href: '/partners#faq', label: 'Questions we get' },
  ] },
  { title: 'Legal', links: [
    { href: '/privacy', label: 'Privacy Policy' },
    { href: '/terms', label: 'Terms of Use' },
    { href: '/data-deletion', label: 'Data Deletion' },
  ] },
];
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr__top">
      <a href="/" class="ftr__logo" aria-label="SOBI Interactive, home">SOBI</a>
      <div class="ftr__cols">
        {cols.map((c) => (
          <div>
            <p class="label">{c.title}</p>
            <ul>
              {c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <p class="ftr__legal">Copyright © 2026 SOBI Interactive™. All rights reserved.</p>
  </div>
</footer>

<style>
  .ftr { border-top: 1px solid var(--line); padding: 80px 0 40px; }
  .ftr__top { display: flex; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
  .ftr__logo { font-weight: 900; font-size: clamp(56px, 10vw, 120px); line-height: 0.8; letter-spacing: -0.04em; }
  .ftr__cols { display: grid; grid-template-columns: repeat(3, minmax(140px, auto)); gap: 48px; }
  .ftr ul { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 10px; }
  .ftr li a { color: #cfcfcf; transition: color 0.2s; }
  .ftr li a:hover { color: var(--fg); }
  .ftr__legal { margin: 72px 0 0; padding-top: 24px; border-top: 1px solid var(--line); font-size: 13px; color: var(--mute); }
  @media (max-width: 640px) {
    .ftr__cols { grid-template-columns: 1fr 1fr; gap: 32px; width: 100%; }
  }
</style>
