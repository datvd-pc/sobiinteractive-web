---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { Image } from 'astro:assets';
import quyen from '../assets/team/quyen.png';
import sophia from '../assets/team/sophia.png';
import huy from '../assets/team/huy.png';
import kien from '../assets/team/kien.png';
import quang from '../assets/team/quang.png';
import lan from '../assets/team/lan.png';

// Team shown on the About page (owner approved names and roles, 2026-11-20).
const team = [
  { name: 'Quyen Alice Nguyen', role: 'Game Designer', photo: quyen },
  { name: 'Sophia Nguyen', role: '2D Artist', photo: sophia },
  { name: 'Huy Mario Nguyen', role: 'Developer', photo: huy },
  { name: 'Kien Tran', role: 'Developer', photo: kien },
  { name: 'Quang Nguyen', role: 'Developer', photo: quang },
  { name: 'Lan Trinh', role: 'Marketing', photo: lan },
];

const values = [
  { title: 'Care', text: 'We polish every level and every small movement, because players feel the difference.' },
  { title: 'Always learning', text: 'Mobile games change every day. We test, measure and learn from players to keep getting better.' },
  { title: 'Honesty', text: 'We say what we do and do what we say, with players, with partners and with each other.' },
  { title: 'Going far together', text: 'A good game is the work of many hands. We believe in building long journeys together.' },
];
---
<Base
  title="About | SOBI Interactive"
  description="SOBI Interactive is a mobile game studio based in Vietnam that believes a good game starts with respect for players and care in every detail."
  image="/og/og-about.png"
  jsonLd={{ '@type': 'AboutPage', name: 'About SOBI Interactive', about: { '@id': 'https://sobiinteractive.com/#organization' } }}
>
  <PageHero l1="We are" l2="SOBI Interactive.">
    <p class="lead">SOBI Interactive is a mobile game studio based in Vietnam. We are a small studio that believes a good game starts with respect for players and care in every detail.</p>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <h2 data-reveal>What we<br />stand for</h2>
      <div class="values">
        {values.map((v, i) => (
          <article class="value" data-reveal>
            <span class="value__no">0{i + 1}</span>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="team">
    <div class="wrap">
      <h2 data-reveal>The team</h2>
      <div class="team">
        {team.map((p) => (
          <article class="member" data-reveal>
            <Image src={p.photo} alt={`${p.name}, ${p.role} at SOBI Interactive`} width={480} height={480} class="member__photo" loading="lazy" />
            <h3 class="member__name">{p.name}</h3>
            <p class="member__role">{p.role}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="careers">
    <div class="wrap split">
      <h2 data-reveal>Careers</h2>
      <div data-reveal>
        <p class="split__big">Make memorable games with SOBI.</p>
        <p class="lead">We have no open positions listed yet. If you love making games and want to grow with SOBI, send us a short note about what you have worked on through our Contact page. We read every message.</p>
        <a href="/contact" class="btn careers__btn">Contact us</a>
      </div>
    </div>
  </section>

  <CtaBlock />
</Base>

<style>
  .values {
    margin-top: 64px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .value { background: var(--card); border: 1px solid var(--line); padding: 32px 28px 36px; }
  .value__no { display: block; font-weight: 900; font-size: 14px; color: var(--mute); letter-spacing: 0.1em; }
  .value h3 { margin-top: 48px; font-size: clamp(22px, 2vw, 26px); }
  .value p { margin: 16px 0 0; color: #cfcfcf; font-weight: 300; }

  .team {
    margin-top: 64px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .member { background: var(--card); border: 1px solid var(--line); padding: 16px 16px 24px; }
  .member__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.4s ease;
  }
  .member:hover .member__photo { filter: none; }
  .member__name { margin-top: 20px; font-size: clamp(18px, 1.8vw, 22px); }
  .member__role { margin: 8px 0 0; color: var(--mute); font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700; }

  .split { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px; }
  .split__big { margin: 0 0 20px; font-size: clamp(24px, 3vw, 36px); font-weight: 700; line-height: 1.2; }
  .split .lead { margin: 0; }
  .careers__btn { margin-top: 36px; }

  @media (max-width: 1000px) { .values { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .team { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: 40px; } .member { padding: 10px 10px 18px; } }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; gap: 24px; } }
  @media (max-width: 560px) { .values { grid-template-columns: 1fr; margin-top: 40px; } .value h3 { margin-top: 28px; } }
</style>
