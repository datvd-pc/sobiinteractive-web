---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import TileBand from '../components/TileBand.astro';
import { orgRef } from '../data/seo';

// Form submissions are delivered to contact@sobiinteractive.com by Web3Forms.
// Set PUBLIC_WEB3FORMS_KEY in web/.env. Without a key the form opens the visitor's mail app instead.
const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const email = 'contact@sobiinteractive.com';

const ways = [
  { title: 'Co-development', text: 'We build a game together with you and share the revenue.' },
  { title: 'Full-service development', text: 'You set the brief. We build the game for you, from the first concept to a build ready for players.' },
  { title: 'Games from our library', text: 'Pick a game from our existing library and publish it.' },
];

const faqs = [
  { q: 'What kinds of games do you make?', a: 'Casual, puzzle, hybrid-casual, hybrid puzzle, idle and hybrid idle games for Android and iOS.' },
  { q: 'Can we see a game before we sign?', a: 'Yes. We share the concept and a playable prototype first, so you can judge the game in your hands before any agreement.' },
  { q: 'How fast can you build a prototype?', a: 'Usually in 2 to 5 days, depending on what the game needs.' },
  { q: 'How can we work together?', a: 'In three ways: we co-develop a game with you and share the revenue, we build a game for you as a full-service team, or you publish a game from our existing library.' },
  { q: 'Do you integrate our SDKs and share the data?', a: "Yes. We integrate your SDKs and share all of the game's data with you." },
];

const jsonLd = [
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  ...ways.map((w) => ({
    '@type': 'Service',
    name: `${w.title} for mobile game publishers`,
    description: w.text,
    serviceType: w.title,
    provider: orgRef,
    areaServed: 'Worldwide',
    audience: { '@type': 'BusinessAudience', audienceType: 'Mobile game publishers' },
  })),
];
---
<Base
  title="Partners | SOBI Interactive"
  description="SOBI Interactive works with publishers who want a dedicated mobile game team in Vietnam: co-development, full-service development and games from our library."
  image="/og/og-partners.png"
  jsonLd={jsonLd}
>
  <PageHero l1="Build it" l2="with us.">
    <p class="lead">From the first idea to a game ready for players, SOBI works with publishers who want a dedicated mobile game team in Vietnam.</p>
    <div class="actions">
      <a href="#submit" class="btn">Talk to us</a>
      <a href="#faq" class="link-arrow">Questions we get →</a>
    </div>
  </PageHero>

  <section class="section" id="publishers">
    <div class="wrap">
      <h2 data-reveal>Three ways<br />to work together</h2>
      <div class="ways">
        {ways.map((w, i) => (
          <article class="way" data-reveal>
            <p class="label">0{i + 1}</p>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </article>
        ))}
      </div>
      <a href="#submit" class="btn ways__btn" data-reveal>Talk to us</a>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap faq-wrap">
      <h2 data-reveal>Questions<br />we get</h2>
      <div class="faq" data-reveal>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}<span class="faq__icon" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <TileBand />

  <section class="section" id="submit">
    <div class="wrap form-wrap">
      <div data-reveal>
        <p class="label">Let's go further together</p>
        <h2 class="form-title">Tell us what you are looking for.</h2>
        <p class="lead">A few details help us bring the right games and the right team to our first conversation.</p>
      </div>

      <form class="form" id="partner-form" data-key={formKey} data-email={email} novalidate data-reveal>
        <label class="field"><span>Company name</span><input name="company" required autocomplete="organization" /></label>
        <label class="field"><span>Your name</span><input name="name" required autocomplete="name" /></label>
        <label class="field"><span>Email</span><input name="email" type="email" required autocomplete="email" /></label>
        <label class="field"><span>Country</span><input name="country" required autocomplete="country-name" /></label>
        <label class="field field--full"><span>How would you like to work with us?</span>
          <select name="work_type" required>
            <option value="" disabled selected hidden>Select</option>
            <option>Co-development</option><option>Full-service development</option><option>Games from your library</option><option>Not sure yet</option>
          </select>
        </label>
        <label class="field field--full"><span>What kind of games are you looking for?</span><textarea name="looking_for" rows="5" required></textarea></label>

        <label class="check field--full">
          <input type="checkbox" name="consent" required />
          <span>I have read the <a href="/privacy">Privacy Policy</a> and agree that SOBI may use this information to reply to my enquiry.</span>
        </label>

        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="field--full form__foot">
          <button type="submit" class="btn">Send it</button>
          <p class="form__msg" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>
</Base>

<style>
  .ways { margin-top: 64px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .way { background: var(--card); border: 1px solid var(--line); padding: 36px 32px 40px; }
  .way .label { margin: 0; }
  .way h3 { margin-top: 48px; font-size: clamp(22px, 2.2vw, 28px); }
  .way > p:not(.label) { margin: 16px 0 0; color: #cfcfcf; font-weight: 300; }
  .ways__btn { margin-top: 40px; }

  .faq-wrap { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px; align-items: start; }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq details:first-child { border-top: 1px solid var(--line); }
  .faq summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 0;
    font-weight: 700;
    font-size: clamp(18px, 1.8vw, 21px);
    line-height: 1.35;
    cursor: pointer;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq__icon { position: relative; flex: none; width: 16px; height: 16px; }
  .faq__icon::before, .faq__icon::after { content: ''; position: absolute; left: 0; top: 7px; width: 16px; height: 2px; background: var(--fg); transition: transform 0.25s; }
  .faq__icon::after { transform: rotate(90deg); }
  .faq details[open] .faq__icon::after { transform: rotate(0deg); }
  .faq details p { margin: 0 0 28px; color: #cfcfcf; font-weight: 300; max-width: 620px; }

  .form-wrap { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 64px; align-items: start; }
  .form-title { margin: 20px 0 24px; }
  .form { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .group { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .group[hidden] { display: none; }
  .field--full { grid-column: 1 / -1; }
  .field { display: grid; gap: 8px; border: 0; padding: 0; margin: 0; min-width: 0; }
  .field > span, .field legend { font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mute); padding: 0; }
  input:not([type='radio']):not([type='checkbox']), select, textarea {
    width: 100%;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0;
    color: var(--fg);
    font: 400 16px/1.5 'Be Vietnam Pro', sans-serif;
    padding: 14px 16px;
    transition: border-color 0.2s;
  }
  select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, #888 50%), linear-gradient(135deg, #888 50%, transparent 50%); background-position: calc(100% - 22px) 50%, calc(100% - 16px) 50%; background-size: 6px 6px; background-repeat: no-repeat; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--fg); }
  .is-invalid { border-color: #ff5a5a !important; }
  textarea { resize: vertical; }

  .seg { display: flex; gap: 0; margin-top: 8px; }
  .seg label { flex: 1; }
  .seg input { position: absolute; opacity: 0; pointer-events: none; }
  .seg span { display: block; text-align: center; padding: 14px; border: 1px solid var(--line); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; font-size: 14px; color: var(--mute); transition: all 0.2s; }
  .seg input:checked + span { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .seg input:focus-visible + span { outline: 2px solid var(--fg); outline-offset: 3px; }

  .check { display: flex; gap: 12px; align-items: flex-start; font-size: 15px; color: #cfcfcf; }
  .check input { margin-top: 4px; width: 18px; height: 18px; accent-color: #fff; flex: none; }
  .check a { text-decoration: underline; }
  .hp { position: absolute; left: -9999px; }
  .form__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 8px; }
  .form__msg { margin: 0; font-size: 15px; }
  .form__msg.is-error { color: #ff5a5a; }

  @media (max-width: 900px) {
    .ways, .form-wrap, .faq-wrap { grid-template-columns: 1fr; }
    .faq-wrap { gap: 32px; }
    .ways { margin-top: 40px; }
    .form-wrap { gap: 40px; }
  }
  @media (max-width: 560px) {
    .form, .group { grid-template-columns: 1fr; }
    .way { padding: 32px 24px; }
  }
</style>

<script>
  const form = document.getElementById('partner-form') as HTMLFormElement | null;
  if (form) {
    const msg = form.querySelector<HTMLElement>('.form__msg')!;
    const visibleFields = () =>
      [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea')]
        .filter((el) => el.name !== 'botcheck');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.textContent = '';
      msg.classList.remove('is-error');

      let bad: HTMLElement | null = null;
      visibleFields().forEach((el) => {
        const needed = el.required || el.hasAttribute('data-req');
        const empty = el.type === 'checkbox' ? !(el as HTMLInputElement).checked : !el.value.trim();
        const invalid = (needed && empty) || (el.value && !el.checkValidity());
        el.classList.toggle('is-invalid', !!invalid);
        if (invalid && !bad) bad = el;
      });
      if (bad) {
        msg.textContent = 'Please fill in the highlighted fields.';
        msg.classList.add('is-error');
        (bad as HTMLElement).focus();
        return;
      }

      const lines: string[] = [];
      visibleFields().forEach((el) => {
        if (el.name === 'consent' || !el.value) return;
        const label = el.closest('label')?.querySelector('span')?.textContent ?? el.name;
        lines.push(`${label}: ${el.value}`);
      });
      const company = (form.elements.namedItem('company') as HTMLInputElement).value;
      const subject = `Publisher enquiry from ${company} (sobiinteractive.com)`;

      const key = form.dataset.key;
      if (!key) {
        location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
        return;
      }

      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      btn.disabled = true;
      msg.textContent = 'Sending…';
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: key,
            subject,
            from_name: 'SOBI website',
            replyto: (form.elements.namedItem('email') as HTMLInputElement).value,
            botcheck: (form.elements.namedItem('botcheck') as HTMLInputElement).checked,
            message: lines.join('\n'),
          }),
        });
        const data = await res.json();
        if (!data.success) throw new Error(data.message);
        form.reset();
        msg.textContent = 'Thank you. Your message has reached us.';
      } catch {
        msg.textContent = `Something went wrong. Please email us at ${form.dataset.email}.`;
        msg.classList.add('is-error');
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
